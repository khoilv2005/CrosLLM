{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crossllm.local/schemas/canary_version_rehearsal.schema.json",
  "title": "CrossLLM synthetic M08 canary version rehearsal",
  "description": "Development-only version block rehearsal with synthetic identities.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "record_type", "scope", "admission_eligible", "provider_calls",
    "case_ids", "cases", "case_count", "passed_count", "all_passed", "limitations", "report_hash"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "record_type": {"const": "synthetic_m08_canary_version_rehearsal"},
    "scope": {"const": "development_version_block_rehearsal_only"},
    "admission_eligible": {"const": false},
    "provider_calls": {"const": 0},
    "case_ids": {"type": "array", "const": [
      "matching_identity_passes", "failed_panel_blocks", "identity_drift_blocks", "explicit_deviation_is_distinct"
    ]},
    "cases": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "passed", "assertions", "evidence_sha256"],
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "passed": {"type": "boolean"},
          "assertions": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "boolean"}},
          "evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "case_count": {"const": 4},
    "passed_count": {"const": 4},
    "all_passed": {"const": true},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "report_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
