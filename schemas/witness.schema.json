{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crossllm.invalid/schemas/witness.schema.json",
  "title": "CrossLLM replay witness",
  "description": "Strict public witness contract. Independent replay evidence is added later and is never inferred from a native fixture replay.",
  "type": "object",
  "required": [
    "schema_version", "witness_id", "query_id", "initial_state_hash", "trace_hash",
    "actions", "domains", "created_at", "proof_objects", "native_replay_status",
    "independent_replay_status", "security_relevance", "allowed_capabilities"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "witness_id": {"$ref": "#/$defs/id"},
    "query_id": {"$ref": "#/$defs/id"},
    "initial_state_hash": {"$ref": "#/$defs/sha256"},
    "trace_hash": {"$ref": "#/$defs/sha256"},
    "actions": {"type": "array", "items": {"$ref": "#/$defs/action"}},
    "domains": {"type": "array", "items": {"$ref": "#/$defs/id"}, "uniqueItems": true},
    "created_at": {"type": "string", "minLength": 1},
    "proof_objects": {"type": "object"},
    "native_replay_status": {"$ref": "#/$defs/replayStatus"},
    "independent_replay_status": {"$ref": "#/$defs/replayStatus"},
    "security_relevance": {"enum": ["unassessed", "relevant", "irrelevant", "unknown"]},
    "allowed_capabilities": {"type": "array", "items": {"$ref": "#/$defs/id"}, "uniqueItems": true}
  },
  "additionalProperties": false,
  "$defs": {
    "id": {"type": "string", "minLength": 1},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "replayStatus": {"enum": ["pass", "fail", "unknown", "unsupported"]},
    "message": {
      "type": "object",
      "required": ["source_domain", "destination_domain", "emitter", "recipient", "nonce", "payload_commitment"],
      "properties": {
        "source_domain": {"$ref": "#/$defs/id"},
        "destination_domain": {"$ref": "#/$defs/id"},
        "emitter": {"$ref": "#/$defs/id"},
        "recipient": {"$ref": "#/$defs/id"},
        "nonce": {"type": "integer", "minimum": 0, "maximum": 115792089237316195423570985008687907853269984665640564039457584007913129639935},
        "payload_commitment": {"$ref": "#/$defs/id"},
        "intent_id": {"type": ["string", "null"], "minLength": 1},
        "attestation": {"type": ["string", "null"], "minLength": 1},
        "attestor": {"type": ["string", "null"], "minLength": 1}
      },
      "additionalProperties": false
    },
    "action": {
      "type": "object",
      "required": ["action", "message", "transaction_index", "channel_transition_index", "pending_before", "pending_after"],
      "properties": {
        "action": {"enum": ["enqueue", "deliver", "reorg"]},
        "message": {"$ref": "#/$defs/message"},
        "transaction_index": {"type": "integer", "minimum": 0},
        "channel_transition_index": {"type": "integer", "minimum": 0},
        "pending_before": {"type": "integer", "minimum": 0},
        "pending_after": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    }
  }
}
