{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crossllm.local/schemas/recall_rehearsal.schema.json",
  "title": "CrossLLM separated proposal and end-to-end recall rehearsal",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_type", "scope", "synthetic_fixture_inputs", "provider_calls", "admission_eligible", "proposal_prefix", "end_to_end", "endpoint_separation", "limitations", "report_hash"],
  "properties": {
    "schema_version": {"const": 1},
    "record_type": {"const": "synthetic_m07_recall_rehearsal"},
    "scope": {"const": "development_recall_rehearsal_only"},
    "synthetic_fixture_inputs": {"const": true},
    "provider_calls": {"const": 0},
    "admission_eligible": {"const": false},
    "proposal_prefix": {"type": "object"},
    "end_to_end": {"type": "object"},
    "endpoint_separation": {"const": true},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "report_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
