{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crossllm.local/schemas/source_case_harness.schema.json",
  "title": "CrossLLM source-case harness execution probe",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "record_type", "scope", "gold_fields_read",
    "candidate_specific", "xlir_search_run", "witness_check_run",
    "independent_replay_run", "foundry_image", "match_test", "timeout_seconds", "result",
    "status", "report_sha256"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "record_type": {"const": "source_case_harness_probe"},
    "scope": {"const": "source_backed_case_harness_execution_probe"},
    "gold_fields_read": {"const": false},
    "candidate_specific": {"const": false},
    "xlir_search_run": {"const": false},
    "witness_check_run": {"const": false},
    "independent_replay_run": {"const": false},
    "foundry_image": {"type": "string", "pattern": "@sha256:[0-9a-fA-F]{64}$"},
    "match_test": {"type": ["string", "null"]},
    "timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
    "compiler_volume": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,62}$"},
    "result": {"$ref": "#/$defs/result"},
    "status": {"enum": ["pass", "blocked"]},
    "report_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lineage_id", "case_id", "status", "exit_code",
        "stdout_sha256", "stderr_sha256", "reason"
      ],
      "properties": {
        "lineage_id": {"type": "string", "minLength": 1},
        "case_id": {"type": "string", "minLength": 1},
        "status": {"enum": ["pass", "fail", "timeout", "tool_error", "input_error"]},
        "exit_code": {"type": ["integer", "null"]},
        "stdout_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "stderr_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "reason": {"type": ["string", "null"]}
      }
    }
  }
}
