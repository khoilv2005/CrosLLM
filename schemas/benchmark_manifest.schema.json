{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "title": "CrossLLM public benchmark manifest (basic structural schema)",
  "required": [
    "instance_id",
    "lineage_id",
    "version_id",
    "split",
    "cohort",
    "status",
    "source_commit",
    "source_sha256",
    "artifact_pack_sha256",
    "property_family",
    "native_evm_scope"
  ],
  "properties": {
    "instance_id": {
      "type": "string",
      "minLength": 1
    },
    "lineage_id": {
      "type": "string",
      "minLength": 1
    },
    "version_id": {
      "type": "string",
      "minLength": 1
    },
    "split": {
      "enum": [
        "development",
        "evaluation"
      ]
    },
    "cohort": {
      "enum": [
        "historical",
        "sealed",
        "negative",
        "prospective",
        "adaptation"
      ]
    },
    "status": {
      "enum": [
        "vulnerable",
        "patched",
        "benign"
      ]
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40,64}$"
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "artifact_pack_sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "property_family": {
      "enum": [
        "input_validation",
        "logic",
        "quorum",
        "replay",
        "finality",
        "message_handling"
      ]
    },
    "native_evm_scope": {
      "type": "boolean"
    },
    "chain_pair": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "string"
      }
    }
  },
  "not": {
    "anyOf": [
      {
        "required": [
          "gold_property"
        ]
      },
      {
        "required": [
          "trigger_calldata"
        ]
      },
      {
        "required": [
          "exploit_payload"
        ]
      },
      {
        "required": [
          "mutation_diff"
        ]
      }
    ]
  }
}
