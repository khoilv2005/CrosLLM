{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crossllm.local/schemas/analysis_rehearsal.schema.json",
  "title": "CrossLLM synthetic M09 analysis rehearsal",
  "description": "Development-only rehearsal of adjudication, estimands, inference, tables and figures.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "record_type", "scope", "synthetic_fixture_inputs",
    "provider_calls", "admission_eligible", "analysis", "adjudication",
    "sampling", "inference", "figures", "outputs", "limitations", "report_hash"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "record_type": {"const": "synthetic_m09_analysis_rehearsal"},
    "scope": {"const": "development_analysis_rehearsal_only"},
    "synthetic_fixture_inputs": {"const": true},
    "provider_calls": {"const": 0},
    "admission_eligible": {"const": false},
    "analysis": {"type": "object"},
    "adjudication": {"type": "object"},
    "sampling": {"type": "object"},
    "inference": {"type": "object"},
    "figures": {"type": "array", "minItems": 5, "items": {"type": "object"}},
    "outputs": {"type": "object"},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "report_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
