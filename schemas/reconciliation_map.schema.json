{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crossllm.local/schemas/reconciliation_map.schema.json",
  "title": "CrossLLM guide-to-repository reconciliation map",
  "description": "Hash-bound navigation contract for legacy Experiment Guide paths.",
  "type": "object",
  "required": [
    "schema_version",
    "record_type",
    "status",
    "generated_on",
    "entries",
    "source_of_truth",
    "mapping_hash",
    "report_hash"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "record_type": {"const": "repository_reconciliation_map"},
    "status": {"const": "development_mapping_complete"},
    "generated_on": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["guide_reference", "canonical_paths", "use", "admission_boundary"],
        "properties": {
          "guide_reference": {"type": "string", "minLength": 1},
          "canonical_paths": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "optional_paths": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "use": {"type": "string", "minLength": 1},
          "admission_boundary": {"type": "string", "minLength": 1},
          "file_sha256": {
            "type": "object",
            "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        },
        "additionalProperties": false
      }
    },
    "source_of_truth": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "mapping_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "report_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
