{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crossllm.local/schemas/provider_contract_rehearsal.schema.json",
  "title": "CrossLLM synthetic M06 provider contract rehearsal",
  "description": "Fake-sender-only contract rehearsal; it cannot establish provider identity or evaluation readiness.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "record_type", "scope", "admission_eligible",
    "fake_server_only", "ollama_cloud_calls", "synthetic_transport_calls",
    "endpoint_policy", "case_ids", "cases", "case_count", "passed_count",
    "all_passed", "hash_inputs", "limitations", "report_hash"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "record_type": {"const": "synthetic_m06_provider_contract_rehearsal"},
    "scope": {"const": "development_provider_contract_rehearsal_only"},
    "admission_eligible": {"const": false},
    "fake_server_only": {"const": true},
    "ollama_cloud_calls": {"const": 0},
    "synthetic_transport_calls": {"type": "integer", "minimum": 1},
    "endpoint_policy": {"const": "https://ollama.com/api/chat"},
    "case_ids": {"type": "array", "const": [
      "success_raw_capture", "malformed_missing_partial", "retry_429_5xx_timeout",
      "cancellation_and_deadline", "archive_hash_round_trip", "ordered_slot_statuses",
      "budget_and_tokenizer_boundaries", "four_family_preflight_boundary",
      "x_p_t0_shared_call_boundary"
    ]},
    "cases": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "passed", "assertions", "evidence_sha256"],
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "passed": {"type": "boolean"},
          "assertions": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {"type": "boolean"}
          },
          "evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "case_count": {"const": 9},
    "passed_count": {"const": 9},
    "all_passed": {"const": true},
    "hash_inputs": {
      "type": "object",
      "minProperties": 6,
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "report_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
