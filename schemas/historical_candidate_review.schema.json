{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crossllm.local/schemas/historical_candidate_review.schema.json",
  "title": "CrossLLM historical candidate review",
  "description": "Fail-closed mechanical review of a historical candidate. This record is not human adjudication or evaluation admission.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "protocol",
    "lineage_id",
    "source_ids",
    "case_snapshot_sha256",
    "source_registry_snapshot_sha256",
    "review_mode",
    "admission_status",
    "admission_eligible",
    "gates",
    "lineage_independence",
    "blocking_reasons",
    "evidence_scope"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "case_id": {"type": "string", "minLength": 3},
    "protocol": {"type": "string", "minLength": 1},
    "lineage_id": {"type": "string", "minLength": 2},
    "source_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "case_snapshot_sha256": {"$ref": "#/$defs/sha256"},
    "source_registry_snapshot_sha256": {"$ref": "#/$defs/sha256"},
    "review_mode": {"const": "mechanical_fail_closed"},
    "admission_status": {"enum": ["candidate", "rejected"]},
    "admission_eligible": {"const": false},
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_registry_binding",
        "native_evm_eligibility",
        "vulnerable_revision",
        "patched_revision",
        "trigger_validation",
        "matched_control",
        "threat_assumptions"
      ],
      "properties": {
        "source_registry_binding": {"$ref": "#/$defs/gate"},
        "native_evm_eligibility": {"$ref": "#/$defs/gate"},
        "vulnerable_revision": {"$ref": "#/$defs/gate"},
        "patched_revision": {"$ref": "#/$defs/gate"},
        "trigger_validation": {"$ref": "#/$defs/gate"},
        "matched_control": {"$ref": "#/$defs/gate"},
        "threat_assumptions": {"$ref": "#/$defs/gate"}
      }
    },
    "lineage_independence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "related_case_ids", "reason"],
      "properties": {
        "status": {"enum": ["pass", "pending", "fail"]},
        "related_case_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "blocking_reasons": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "evidence_scope": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence_refs", "reason"],
      "properties": {
        "status": {"enum": ["pass", "pending", "fail"]},
        "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "reason": {"type": "string", "minLength": 1}
      }
    }
  }
}
